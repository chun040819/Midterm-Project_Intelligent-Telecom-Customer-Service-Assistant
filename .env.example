# 全部為 Server 端設定；絕不使用 NEXT_PUBLIC_ 前綴存放金鑰。
LLM_API_KEY=
LLM_BASE_URL=https://www.iai.nkust.edu.tw/aihub/v1/
# 固定使用的對話模型（課程 NKUST AI Hub 託管，無額外版本標籤）。
LLM_MODEL=Furen-large
# RAG 嵌入模型固定為 intfloat/multilingual-e5-small @ 614241f622f53c4eeff9890bdc4f31cfecc418b3
# （定義於 backend/rag/config.py，換版需重新校準 MAX_DISTANCE）。
FASTAPI_BASE_URL=http://127.0.0.1:8000
INTERNAL_SERVICE_TOKEN=change-me-to-a-long-random-string
DEMO_BUSINESS_DATE=2026-11-03
SQLITE_PATH=./.local/telcocare.sqlite3
CHROMA_PATH=./.local/chroma
